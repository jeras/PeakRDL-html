{% import 'systemrdl_properties.jinja' as properties -%}
{% macro heading(class, type_name) -%}
{% if class == "Addrmap" %}{% set section_class = "Address map"   %}{% endif -%}
{% if class == "Regfile" %}{% set section_class = "Register file" %}{% endif -%}
{% if class == "Reg"     %}{% set section_class = "Register"      %}{% endif -%}
{% if class == "Field"   %}{% set section_class = "Register field"%}{% endif -%}
{{ section_class }}: {{ type_name }}
{% endmacro -%}

{%- macro print_properties(node, property_dict) -%}
    {% set property_list = [] -%}
    {% for property in property_dict.properties.keys() -%}
        {% set value = node.get_property(property) -%}
        {% if value is boolean -%}
            {% if value is true -%}
                {% do property_list.append(property) -%}
            {% endif -%}
        {% elif value is number -%}
            {% do property_list.append(property+'='+value.__repr__()) -%}
        {% elif isinstance(value, (systemrdl.node.SignalNode, systemrdl.node.FieldNode)) -%}
            {% do property_list.append('TODO') -%}
        {% elif value is none -%}
        {% else -%}
            {% do property_list.append(property+'='+value.name) -%}
        {% endif -%}
    {% endfor -%}
    {% if property_list %}
        {{- property_dict.name }}: `{{ property_list|join(', ') }}`
    {%- endif %}
{% endmacro -%}

{% for type_name, component in components.items() recursive -%}
{% set node = component.instances[0] -%}
{{ '#' * loop.depth }} {{ heading(node.inst.__class__.__name__, node.get_property('name')) }}

{% if isinstance(node, (systemrdl.node.AddrmapNode, systemrdl.node.RegfileNode, systemrdl.node.RegNode)) -%}
- Definition: `{{ type_name }}`
- Offset: `{{ "0x{:0{fill_width}X}".format(node.address_offset, fill_width = 8) }}`

{% endif -%}

{% if isinstance(node, (systemrdl.node.AddrmapNode, systemrdl.node.RegfileNode)) -%}

| Offset | class | type name | instance | name |
|--------|-------|-----------|----------|------|
{% for row in node.children() -%}
{% set link = '#' ~ heading(row.inst.__class__.__name__, row.get_property('name'))|slug -%}
| `{{ "0x{:0{fill_width}X}".format(row.address_offset, fill_width = 8) }}` | `{{ row.inst.__class__.__name__ }}` | [`{{ row.inst.type_name }}`]({{ link }}) | `{{ row.inst.inst_name }}` | {{ row.get_property('name') }} |
{% endfor %}

{% elif isinstance(node, (systemrdl.node.RegNode)) -%}

| range | SW | HW | reset | type name | instance | name |
|-------|----|----|-------|-----------|----------|------|
{% for row in node.children() -%}
{% set link = '#' ~ heading(row.inst.__class__.__name__, row.get_property('name'))|slug -%}
| `{{ "[{:d}:{:d}]".format(row.inst.msb, row.inst.lsb) }}` | `{{ row.get_property('sw').name }}` | `{{ row.get_property('hw').name }}` | `{{ "0x{:0{fill_width}x}".format(row.get_property("reset", default=0), fill_width=8) }}` | [`{{ row.inst.type_name }}`]({{ link }}) | `{{ row.inst.inst_name }}` | {{ row.get_property('name') }} |
{% endfor %}

{% elif isinstance(node, (systemrdl.node.FieldNode)) -%}

{{- print_properties(node, properties.dict_properties['sw_access']) -}}
{{- print_properties(node, properties.dict_properties['hw_access']) -}}
{{- print_properties(node, properties.dict_properties['counter']) -}}
{{- print_properties(node, properties.dict_properties['interrupt']) -}}
{{- print_properties(node, properties.dict_properties['miscelaneous']) -}}

{% endif %}

{% if node.get_property('desc') %}{{ node.get_property('desc') }}{% endif %}

{{ loop(component.components.items()) -}}

{%- endfor -%}