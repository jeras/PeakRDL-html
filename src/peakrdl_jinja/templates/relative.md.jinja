{% import 'systemrdl_properties.jinja' as properties -%}

{#- macro for creating headings -#}
{% macro heading(node) -%}
{%     set class = node.inst.__class__.__name__ -%}
{%     if class == "Addrmap" %}{% set section_class = "Address map"   %}{% endif -%}
{%     if class == "Regfile" %}{% set section_class = "Register file" %}{% endif -%}
{%     if class == "Reg"     %}{% set section_class = "Register"      %}{% endif -%}
{%     if class == "Field"   %}{% set section_class = "Register field"%}{% endif -%}
{{ section_class }}: `{{ node.get_global_type_name(separator='.') }}`
{%- endmacro -%}

{#- macro for formatting address and data literals -#}
{% macro format_literal(value, width) -%}
{{ "0x{:0{width}X}".format(value, width = 8) }}
{%- endmacro -%}

{#- macro for formatting field ranges -#}
{% macro format_range(field) -%}
{{ "[{:d}:{:d}]".format(field.inst.msb, field.inst.lsb) }}
{%- endmacro -%}

{#- macro for printing a given subset of properties -#}
{% macro print_properties(node, propertis_for_node) -%}
{%     for property_group in propertis_for_node -%}
{%         set property_list = [] -%}
{%         for property in properties.dict_properties[property_group].properties -%}
{%             set value = node.get_property(property) -%}
{%             if value is boolean -%}
{%                 if value is true -%}
{%                     do property_list.append(property) -%}
{%                 endif -%}
{%             elif value is number -%}
{%                 do property_list.append(property+'='+value.__repr__()) -%}
{%             elif isinstance(value, (systemrdl.node.SignalNode, systemrdl.node.FieldNode)) -%}
{%                 do property_list.append('TODO') -%}
{%             elif value is none -%}
{%             else -%}
{%                 do property_list.append(property+'='+value.name) -%}
{%             endif -%}
{%         endfor -%}
{%         if property_list -%}
- {{ properties.dict_properties[property_group].name }}: `{{ property_list|join(', ') }}`
{%         endif -%}
{%     endfor -%}
{% endmacro -%}

{#- construct a dictionary of global type names and their instances -#}
{% set global_components = {} %}
{% for child in nodes recursive -%}
{%     set global_type_name = child.get_global_type_name(separator='.') -%}
{%     if global_type_name in global_components -%}
{%         do global_components[global_type_name].append(child) -%}
{%     else -%}
{%         do global_components.update({global_type_name: [child]}) -%}
{%     endif -%}
{%     do loop(child.children()) -%}
{% endfor -%}

{#- main recursive loop -#}
{% for child in nodes recursive -%}
{%     set global_type_name = child.get_global_type_name(separator='.') -%}
{%     if child == global_components[global_type_name][0] %}

{#- heading for each node -#}
{{ '#' * loop.depth }} {{ heading(child) }}

{% if child.get_property('name') -%}
- Name: {{ child.get_property('name') }}
{% endif -%}
{% if isinstance(child, (systemrdl.node.AddrmapNode, systemrdl.node.RegfileNode, systemrdl.node.RegNode)) -%}
- Component definition path: `{{ global_type_name }}`
- Address offset: `{{ format_literal(child.address_offset, 32) }}`
- Instance absolute address and full path:
{% for instance in global_components[global_type_name] %}
    `@ {{ format_literal(instance.raw_absolute_address) }}: {{ instance.get_path() }}`
{% endfor -%}

{% endif -%}

{% if isinstance(child, (systemrdl.node.AddrmapNode)) -%}

{{ print_properties(child, ['addrmap']) }}

| Offset | class | type name | instance | name |
|--------|-------|-----------|----------|------|
{% for row in child.children() -%}
{% set link = '#' ~ heading(row)|slug -%}
| `{{ format_literal(row.address_offset, 32) }}` | `{{ row.inst.__class__.__name__ }}` | [`{{ row.get_global_type_name(separator='.') }}`]({{ link }}) | `{{ row.inst.inst_name }}` | {{ row.get_property('name') }} |
{% endfor %}

{% elif isinstance(child, (systemrdl.node.RegfileNode)) -%}

{{ print_properties(child, ['regfile']) }}

| Offset | class | type name | instance | name |
|--------|-------|-----------|----------|------|
{% for row in child.children() -%}
{% set link = '#' ~ heading(row)|slug -%}
| `{{ format_literal(row.address_offset, 32) }}` | `{{ row.inst.__class__.__name__ }}` | [`{{ row.get_global_type_name(separator='.') }}`]({{ link }}) | `{{ row.inst.inst_name }}` | {{ row.get_property('name') }} |
{% endfor %}

{% elif isinstance(child, (systemrdl.node.MemNode)) -%}

{{ print_properties(child, ['memory']) }}

TODO: print memory specific details.

{% elif isinstance(child, (systemrdl.node.RegNode)) -%}

{{ print_properties(child, ['register']) }}

| range | SW | HW | reset | type name | instance | name |
|-------|----|----|-------|-----------|----------|------|
{% for row in child.children() -%}
{% set link = '#' ~ heading(row)|slug -%}
| `{{ format_range(row) }}` | `{{ row.get_property('sw').name }}` | `{{ row.get_property('hw').name }}` | `{{ format_literal(row.get_property("reset", default=0), 32) }}` | [`{{ row.get_global_type_name(separator='.') }}`]({{ link }}) | `{{ row.inst.inst_name }}` | {{ row.get_property('name') }} |
{% endfor -%}

{% elif isinstance(child, (systemrdl.node.FieldNode)) -%}

{{ print_properties(child, ['sw_access', 'hw_access', 'counter', 'interrupt', 'miscelaneous']) }}

{% elif isinstance(child, (systemrdl.node.SignalNode)) -%}

{{ print_properties(child, ['signal']) }}

{% endif %}

{% if child.get_property('desc') -%}
{{ child.get_property('desc') }}
{% endif -%}

{{ loop(child.children()) -}}
{%-     endif -%}
{%- endfor -%}
