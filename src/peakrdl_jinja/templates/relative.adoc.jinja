| `{{ row.inst.inst_name }}`
| {{ row.get_property('name') }}
{% endfor -%}
|===

{% if child.get_property('desc') -%}
{{ child.get_property('desc') }}
{% endif %}

{{ loop(child.children()) -}}
{%          do predecessors.pop() -%}
{%-     endif -%}
{%- endfor -%}
