{% elif isinstance(child, systemrdl.node.RegNode) -%}
{{ print_properties(child, ['register']) }}
{% set register_reset = 0 -%}
{% for field in child.fields() -%}
{% do register_reset.__add__(field.get_property("reset", default=0) * 2**field.inst.low) -%}
{% endfor %} 
- **Reset value:** `{{ format_literal(register_reset, child.get_property('regwidth')) }}`

.Children
[options=autowidth,header,stripes=hover]
|===
| range | SW | HW | reset | type name | instance | name
{% for row in child.children() -%}
| `{{ format_range(row) }}`
| `{{ row.get_property('sw').name }}`
| `{{ row.get_property('hw').name }}`
| `{{ format_literal(row.get_property("reset", default=0), row.width) }}`
| <<{{ heading(row) }},`{{ row.get_global_type_name(separator='.') }}`>>
| `{{ row.inst.inst_name }}`
| {{ row.get_property('name') }}
{% endfor -%}
|===

{% elif isinstance(child, systemrdl.node.FieldNode) -%}

{{ print_properties(child, ['sw_access', 'hw_access', 'counter', 'interrupt', 'miscelaneous']) }}
- **Reset value:** `{{ format_literal(child.get_property("reset", default=0), child.width) }}`

{% elif isinstance(child, systemrdl.node.SignalNode) -%}

{{ print_properties(child, ['signal']) }}

{% endif %}

