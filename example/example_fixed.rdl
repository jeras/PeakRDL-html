
////////////////////////////////////////////////////////////////////////////////
// Example fixed-point regfile
// TODO: add license
////////////////////////////////////////////////////////////////////////////////

// definition of user-defined type and property
`include "vhdl_fixed.rdl"

regfile example_fixed #(
    longint unsigned REGWIDTH = 32,
    longint unsigned WIDTH = 24
){
    default regwidth = REGWIDTH;
    default accesswidth = REGWIDTH;

    vhdl_ufixed #(.MSB (16-1), .LSB ( 8)) ufixed8;
    vhdl_ufixed #(.MSB (16-1), .LSB (-8)) ufixed24;

    vhdl_sfixed #(.MSB (16-1), .LSB ( 8)) sfixed8;
    vhdl_sfixed #(.MSB (16-1), .LSB (-8)) sfixed24;

};
